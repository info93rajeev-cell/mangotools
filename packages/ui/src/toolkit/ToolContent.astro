---
import type { ToolContent } from '@mangotools/schemas';
import { CardGrid, ToolCard } from '../discovery/cards.tsx';
import type { Currency } from '../format/numbers.ts';
import type { ToolLink } from '../layout/types.ts';
import { t } from '../strings/en.ts';
import Faq from './Faq.astro';
import WorkedExample from './WorkedExample.astro';

interface Props {
  content: ToolContent;
  related: ToolLink[];
  currency?: Currency | undefined;
}
const { content, related, currency } = Astro.props;
const beforeReferences = content.sections.filter((s) => s.id !== 'references');
const references = content.sections.find((s) => s.id === 'references');
---

<div class="tool-content">
  {
    beforeReferences.map((section) => (
      <details
        id={section.id}
        class="content-disclosure"
        aria-labelledby={`${section.id}-title`}
        data-tool-content-section=""
      >
        <summary>
          <h2 id={`${section.id}-title`}>{section.title}</h2>
        </summary>
        <div class="content-body">
          {section.id === 'faq' ? (
            <Faq items={content.faq} />
          ) : (
            <div class="prose" set:html={section.html} />
          )}
          {section.id === 'worked-example' && content.example ? (
            <WorkedExample example={content.example} currency={currency} />
          ) : null}
        </div>
      </details>
    ))
  }
  {
    related.length > 0 ? (
      <details
        id="related-tools"
        class="content-disclosure"
        aria-labelledby="related-tools-title"
        data-tool-content-section=""
      >
        <summary>
          <h2 id="related-tools-title">{t('related.title')}</h2>
        </summary>
        <div class="content-body">
          <CardGrid>
            {related.map((tool) => (
              <li>
                <ToolCard tool={tool} />
              </li>
            ))}
          </CardGrid>
        </div>
      </details>
    ) : null
  }
  {
    references ? (
      <details
        id={references.id}
        class="content-disclosure"
        aria-labelledby={`${references.id}-title`}
        data-tool-content-section=""
      >
        <summary>
          <h2 id={`${references.id}-title`}>{references.title}</h2>
        </summary>
        <div class="content-body">
          <div class="prose references" set:html={references.html} />
        </div>
      </details>
    ) : null
  }
</div>

<style>
  .tool-content {
    display: grid;
    gap: var(--space-12);
    max-width: 880px;
  }
  .content-disclosure {
    display: grid;
    min-width: 0;
    scroll-margin-top: 80px;
    border-bottom: 1px solid var(--color-border);
  }
  .content-disclosure:first-child {
    border-top: 1px solid var(--color-border);
  }
  .content-disclosure summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    cursor: pointer;
    list-style: none;
  }
  .content-disclosure summary::-webkit-details-marker {
    display: none;
  }
  .content-disclosure summary::after {
    content: '+';
    flex: none;
    color: var(--color-text-subtle);
    font-size: 1.25rem;
    line-height: 1;
  }
  .content-disclosure[open] summary::after {
    content: '−';
  }
  .content-disclosure h2 {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    font-weight: var(--weight-semibold);
  }
  .content-body {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
  }
  .prose {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
    max-width: 72ch;
  }
  /* Code samples scroll inside their own box instead of widening the page on small screens. */
  .prose :global(pre) {
    margin: 0;
    padding: var(--space-3);
    overflow-x: auto;
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
  }
  .prose :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
  }
  .prose :global(ol),
  .prose :global(ul) {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-6);
  }
  .prose :global(li::marker) {
    color: var(--color-text-subtle);
  }
  .prose :global(code) {
    padding: 1px 5px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    font-size: 0.875em;
  }
  .references {
    color: var(--color-text-muted);
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
  }
</style>
