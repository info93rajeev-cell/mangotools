---
import { Icon } from '../primitives/Icon.tsx';
import { t } from '../strings/en.ts';

interface Props {
  kind: 'none' | 'standard' | 'professional' | 'sensitive';
}
const { kind } = Astro.props;
// Phase 1 shows only the professional disclaimer (T1/T2 tools).
const text = kind === 'professional' ? t('disclaimer.professional') : null;
---

{
  text ? (
    <details class="disclaimer" data-disclaimer>
      <summary>
        <Icon name="info" />
        <span>{t('disclaimer.title')}</span>
      </summary>
      <p>{text}</p>
    </details>
  ) : null
}

<style>
  .disclaimer {
    flex: 0 0 auto;
    color: var(--color-text-muted);
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
  }
  .disclaimer summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-height-sm);
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    cursor: pointer;
    list-style: none;
  }
  .disclaimer summary::-webkit-details-marker {
    display: none;
  }
  .disclaimer summary::after {
    content: '+';
    color: var(--color-text-subtle);
    font-size: var(--text-body);
    line-height: 1;
  }
  .disclaimer[open] {
    display: grid;
    flex-basis: 100%;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-subtle);
  }
  .disclaimer[open] summary::after {
    content: '−';
  }
  .disclaimer :global(.icon) {
    color: var(--color-info);
  }
  .disclaimer p {
    max-width: 72ch;
  }
</style>
