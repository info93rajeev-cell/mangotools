---
import type { Processing } from '@mangotools/schemas';
import { Icon } from '../primitives/Icon.tsx';
import FullscreenToggle from './FullscreenToggle.astro';
import { privacyBadge } from './privacyBadge.ts';
import type { ToolHeaderIcon } from './toolHeaderIcons.ts';

interface Props {
  name: string;
  summary: string;
  /** Evidence-based processing from the registry. The badge renders only for `device`. */
  processing: Processing;
  /** Optional large tool icon left of the title (reference layout). */
  icon?: ToolHeaderIcon | undefined;
}
const { name, summary, processing, icon } = Astro.props;
const badge = privacyBadge(processing);
---

<div class:list={['tool-header', { 'has-icon': icon }]}>
  {
    icon ? (
      <span class={`tool-icon tone-${icon.tone}`}>
        <Icon name={icon.name} />
      </span>
    ) : null
  }
  <div class="title-row">
    <h1>{name}</h1>
    <div class="header-badges">
      <button
        type="button"
        class="guide-btn"
        data-guide-trigger=""
        title="How this tool works (step-by-step guide)"
        aria-label="Step-by-step tool guide"
      >
        <span aria-hidden="true">💡</span>
        <span>Guide</span>
      </button>
      <FullscreenToggle />
      {
        badge ? (
          <p class="privacy" title={badge.detail} data-processing={processing}>
            <Icon name="lock" />
            <span>{badge.label}</span>
            <span class="visually-hidden">{badge.detail}</span>
          </p>
        ) : null
      }
    </div>
  </div>
  <p class="summary">{summary}</p>
</div>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (target?.closest('[data-guide-trigger]')) {
      window.dispatchEvent(new CustomEvent('mangotools:open-tour'));
    }
  });
</script>

<style>
  .tool-header {
    display: grid;
    gap: var(--space-1);
  }
  .tool-header.has-icon {
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 18px;
    align-items: center;
  }
  .tool-header.has-icon .summary {
    grid-column: 2;
  }
  .tool-icon {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 18px;
  }
  @media (min-width: 1100px) {
    .tool-header.has-icon {
      zoom: 0.85;
    }
  }
  .tool-icon {
    --icon-fill: currentColor;
    --icon-detail-color: #ffffff;
  }
  .tool-icon :global(svg) {
    width: 48px;
    height: 48px;
    stroke-width: 1.75;
  }
  .tool-header.has-icon .summary {
    font-size: 17px;
    line-height: 1.45;
    color: #3b4f6e;
  }
  :global([data-theme='dark']) .tool-header.has-icon .summary {
    color: #c3cfe0;
  }
  .tone-purple { background: linear-gradient(145deg, #f4ecff, #e6d6ff); color: #7c3aed; }
  .tone-blue { background: #e8f0ff; color: #1665f5; }
  .tone-red { background: #ffe9ea; color: #e5384b; }
  .tone-green { background: #e3f8ec; color: #15924f; }
  .tone-amber { background: #fff3d6; color: #d98a00; }
  :global([data-theme='dark']) .tool-icon { --icon-detail-color: #121a2c; }
  :global([data-theme='dark']) .tone-purple { background: #2e1d4f; color: #c4a2ff; }
  :global([data-theme='dark']) .tone-blue { background: #172a4f; color: #8fb5ff; }
  :global([data-theme='dark']) .tone-red { background: #44181e; color: #ff98a2; }
  :global([data-theme='dark']) .tone-green { background: #10351f; color: #6ee7a0; }
  :global([data-theme='dark']) .tone-amber { background: #3b2a08; color: #fcd34d; }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }
  .header-badges {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .guide-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px var(--space-3) 3px var(--space-2);
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-surface, #ffffff);
    color: var(--color-text, #0f172a);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    font-weight: var(--weight-medium);
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    transition: all 150ms ease;
  }
  .guide-btn:hover {
    background: var(--color-surface-hover, #f8fafc);
    border-color: #f59e0b;
    box-shadow: 0 2px 4px rgba(245, 158, 11, 0.15);
  }
  @media (pointer: coarse) {
    .guide-btn {
      min-height: 44px;
      padding-inline: 12px;
    }
  }
  .privacy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 2px var(--space-3) 2px var(--space-2);
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--color-success) 40%, transparent);
    background: color-mix(in srgb, var(--color-success) 8%, var(--color-bg));
    color: var(--color-success);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
  .title-row h1 {
    font-size: clamp(1.75rem, 1.1rem + 1.6vw, 2.5rem);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .summary {
    color: var(--color-text-muted);
    max-width: 70ch;
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
  }
  @media (min-width: 900px) {
    .summary {
      max-width: 100ch;
    }
  }
  /* Leave the right side of the description line free for a studio's page actions. */
  @media (min-width: 1100px) {
    .summary {
      max-width: min(100ch, 55%);
    }
  }
  @media (max-width: 650px) {
    .tool-header {
      gap: 0;
      margin-bottom: 0;
    }
    .title-row {
      gap: 4px;
      align-items: center;
    }
    .title-row h1 {
      font-size: 22px;
      line-height: 1.15;
      letter-spacing: -0.4px;
      margin: 0;
    }
    .guide-btn {
      padding: 2px 8px;
      font-size: 12px;
    }
    .privacy {
      display: none;
    }
    .summary {
      display: none;
    }
    .tool-header.has-icon {
      column-gap: 12px;
    }
    .tool-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
    }
    .tool-icon :global(svg) {
      width: 28px;
      height: 28px;
    }
    /* With the reference layout the one-line purpose stays visible on phones. */
    .tool-header.has-icon .summary {
      display: block;
      font-size: 14px;
      line-height: 1.45;
      margin-top: 2px;
    }
  }
</style>
