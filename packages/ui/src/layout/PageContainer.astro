---
/** Centres content with the site gutter. "tool" spans the full screen width; "marketing" stays at 1200 px. */
interface Props {
  width?: 'marketing' | 'tool';
  as?: 'div' | 'section' | 'header' | 'footer';
  class?: string;
}
const { width = 'marketing', as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container', className]} data-width={width}>
  <slot />
</Tag>

<style>
  .container {
    box-sizing: border-box;
    width: 100%;
    max-width: calc(var(--width-marketing) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  /* Tool pages use the whole screen width on every laptop size (no empty side bands). */
  .container[data-width='tool'] {
    max-width: none;
  }
  @media (min-width: 1280px) {
    .container[data-width='tool'] {
      padding-inline: 32px;
    }
  }
</style>
