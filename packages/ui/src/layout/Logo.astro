---
/** Brand mark (square with "B") followed by the wordmark. Decorative mark, text is the name. */
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<span class="logo">
  <svg class="mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="8" fill="#FFB000"></rect>
    <path
      fill-rule="evenodd"
      d="M9.5 9.5h7.1c3 0 4.8 1.5 4.8 3.8 0 1.5-.8 2.5-2 2.9 1.6.4 2.6 1.7 2.6 3.4 0 2.2-1.8 3.4-4.8 3.4H9.5zm3.1 2.6v2.9h3.7c1.3 0 2-.5 2-1.45s-.7-1.45-2-1.45zm0 5.3v3h4.1c1.4 0 2.2-.5 2.2-1.5s-.8-1.5-2.2-1.5z"
      fill="#1C1917"></path>
  </svg>
  <span class="wordmark">{name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .mark {
    flex: none;
  }
  .wordmark {
    font-size: 1.0625rem;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    color: var(--color-text);
  }
</style>
