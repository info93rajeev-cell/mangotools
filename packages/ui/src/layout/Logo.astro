---
/** Brand mark (mango square with "M") followed by the wordmark. Decorative mark, text is the name. */
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<span class="logo">
  <svg class="mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="8" fill="#FFB000"></rect>
    <path
      d="M8.5 23V9.5h3.1l4.4 7.3 4.4-7.3h3.1V23h-3.2v-8.1l-3.6 5.9h-1.4l-3.6-5.9V23z"
      fill="#1C1917"></path>
  </svg>
  <span class="wordmark">{name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .mark {
    flex: none;
  }
  .wordmark {
    font-size: 1.0625rem;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.015em;
    color: var(--color-text);
  }
</style>
