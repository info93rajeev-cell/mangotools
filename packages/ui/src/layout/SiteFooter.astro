---
import { t } from '../strings/en.ts';
import Logo from './Logo.astro';
import PageContainer from './PageContainer.astro';
import type { NavCategory } from './types.ts';

interface Props {
  brand: string;
  tagline: string;
  categories: NavCategory[];
  /** Site information pages that exist in this build (About, Privacy, Disclaimer). */
  pages?: NavCategory[];
}
const { brand, tagline, categories, pages = [] } = Astro.props;
---

<footer class="site-footer no-print">
  <PageContainer width="tool" class="inner">
    <div class="brand">
      <Logo name={brand} />
      <p class="tagline">{tagline}</p>
      {
        pages.length > 0 ? (
          <nav aria-label={t('site.info')} class="info">
            <ul>
              {pages.map((p) => (
                <li>
                  <a href={p.url}>{p.name}</a>
                </li>
              ))}
            </ul>
          </nav>
        ) : null
      }
    </div>
    <nav aria-label={t('site.categories')} class="categories">
      <h2 class="heading">{t('site.categories')}</h2>
      <ul>
        <li><a href="/tools">{t('site.allTools')}</a></li>
        {
          categories.map((c) => (
            <li>
              <a href={c.url}>{c.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageContainer>
</footer>

<style>
  /*
   * Approved common footer: brand, tagline and the site pages, a divider, then the categories in
   * compact wrapped rows. Phones centre each block; wide screens put brand left, tagline centred
   * and the site pages right, with the categories in one or two rows below.
   */
  .site-footer {
    margin-top: 0;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-subtle);
  }
  .site-footer :global(.inner) {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    text-align: center;
  }
  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }
  .tagline {
    color: var(--color-text-muted);
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-ui);
  }
  .info ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
  }
  .categories {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    line-height: 2;
  }
  .heading {
    display: inline;
    margin-right: var(--space-3);
    color: var(--color-text);
    font-size: var(--text-ui);
    line-height: inherit;
    font-weight: var(--weight-semibold);
  }
  .categories ul {
    display: inline;
  }
  .categories li {
    display: inline-block;
    margin-inline: var(--space-2);
  }
  a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .site-footer :global(.inner) {
      gap: var(--space-2);
      padding-block: 10px;
      text-align: start;
    }
    .brand {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: var(--space-2) var(--space-5);
    }
    .info {
      justify-self: end;
    }
    .info ul {
      justify-content: flex-end;
      gap: var(--space-2) var(--space-5);
    }
    .categories {
      display: flex;
      align-items: baseline;
      gap: var(--space-4);
      padding-top: var(--space-2);
      line-height: var(--leading-ui);
    }
    .heading {
      flex: none;
      margin: 0;
    }
    .categories ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-5);
    }
    .categories li {
      margin: 0;
    }
  }
</style>
