---
// Generated component for tile-flooring-calculator
---
<div class="civil-workspace-container" data-civil-tool="tile-flooring">
  <form id="calculator" novalidate class="civil-workspace"><div class="civil-input-column"><section class="input-card"><h2 class="sr-only">Areas & Tile Specification</h2><div class="mode-bar" aria-label="Calculation workflow"><button type="button" data-mode="Rectangle" aria-pressed="true"><span class="mode-symbol" aria-hidden="true">▰</span>Rectangle</button><button type="button" data-mode="L-shape" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">▤</span>L-shape</button><button type="button" data-mode="Multiple Areas" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">▥</span>Multiple Areas</button><button type="button" data-mode="Custom Shape" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">▱</span>Custom Shape</button></div><div class="unit-row"><span class="mode-context"></span><label>Dimension unit <select id="unit"><option>m</option><option>ft</option></select></label></div><div class="dimensions"></div><div class="conditional-rows"><section class="row-section" data-rows="areas"><div class="section-head"><h3>Area schedule</h3><span class="row-count"></span></div><div class="row-scroll"><div class="row-head"><span>Area</span><span>Length</span><span>Width / height</span><span>Exclusion m²</span><span>Qty</span><span></span></div><div class="rows"></div></div><button type="button" class="add-row small" data-add="areas">＋ Add area</button></section></div><section class="field-group"><h3>Tile, pattern &amp; purchase</h3><div class="fields"><label class="field" for="target"><span>Tiling surface</span><select id="target"><option>Floor</option><option>Wall</option></select></label><label class="field" for="pattern"><span>Layout pattern</span><select id="pattern"><option>Straight</option><option>Diagonal</option><option>Brick bond</option><option>Herringbone</option><option>Border + field</option></select></label><label class="field" for="tileL"><span>Tile length</span><span class="control"><input id="tileL" type="number" value="600" min="1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">mm</span></span></label><label class="field" for="tileW"><span>Tile width</span><span class="control"><input id="tileW" type="number" value="600" min="1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">mm</span></span></label><label class="field" for="joint"><span>Grout joint</span><span class="control"><input id="joint" type="number" value="3" min="0.1" max="20" step="any" required data-role="" inputmode="decimal"><span class="suffix">mm</span></span></label><label class="field" for="waste"><span>Cut / breakage allowance</span><span class="control"><input id="waste" type="number" value="10" min="0" max="50" step="any" required data-role="" inputmode="decimal"><span class="suffix">%</span></span></label><label class="field" for="perBox"><span>Tiles per box</span><span class="control"><input id="perBox" type="number" value="4" min="1" max="1000" step="any" required data-role="" inputmode="decimal"><span class="suffix"></span></span></label></div></section><div class="validation" role="alert" hidden></div><div class="calculate-row"><button type="submit" class="calculate"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M8 6h8M8 11h2m3 0h2M8 15h2m3 0h2M8 19h2m3 0h2"/></svg>Calculate</button><button type="button" class="reset">Reset</button></div></section>
<div class="advanced-list"><details class="pricing"><summary><span class="price-heading" role="heading" aria-level="2">Cost Estimate <small>Optional · edit rates</small></span><strong class="pricing-total" aria-live="polite"></strong><span aria-hidden="true">＋</span></summary><div class="pricing-body"><div class="pricing-settings"><label class="price-enable"><input id="pricingEnabled" type="checkbox" checked>Include pricing</label><label class="currency-label">Currency<select id="currency"><option value="INR">INR (₹)</option><option value="USD">USD ($)</option><option value="EUR">EUR (€)</option><option value="GBP">GBP (£)</option></select></label></div><p class="pricing-note">Your entered rates only. Zero rates add no cost. Currency changes the label; amounts are not converted. No live prices or FX.</p><div class="pricing-fields"><label class="field" for="boxRate"><span>Tiles / box</span><span class="control"><input id="boxRate" type="number" value="1200" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="adhesiveRate"><span>Adhesive / bag</span><span class="control"><input id="adhesiveRate" type="number" value="0" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="groutRate"><span>Grout / pack</span><span class="control"><input id="groutRate" type="number" value="0" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="underlayRate"><span>Underlay / pack</span><span class="control"><input id="underlayRate" type="number" value="0" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="labourRate"><span>Installation / net m²</span><span class="control"><input id="labourRate" type="number" value="0" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="otherCharges"><span>Other charges · flat</span><span class="control"><input id="otherCharges" type="number" value="0" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label></div><div class="pricing-breakdown"></div><p class="pricing-rounding">Line amounts round to 2 decimal places; the total sums those lines. Cost uses calculated quantities before display rounding.</p><button type="button" class="recalculate-pricing">Recalculate estimate</button></div></details><details class="advanced"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 4 1-3h4l1 3 3 2 3 1v4l-3 2-1 3v3l-4 2-2-3-3-1H5l-2-4 3-2 1-3V7l2-3Z"/><circle cx="12" cy="11" r="3"/></svg>Grout, adhesive, spares &amp; underlayment<span aria-hidden="true">＋</span></summary><div class="advanced-body"><section class="field-group"><h3>Grout, adhesive, spares &amp; underlayment</h3><div class="fields"><label class="field" for="spares"><span>Extra spare tiles</span><span class="control"><input id="spares" type="number" value="4" min="0" max="10000" step="any" required data-role="" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="tileDepth"><span>Grouted depth</span><span class="control"><input id="tileDepth" type="number" value="10" min="0.1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">mm</span></span></label><label class="field" for="groutK"><span>Product grout coefficient</span><span class="control"><input id="groutK" type="number" value="1.6" min="0.1" max="3" step="any" required data-role="" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="adhesive"><span>Adhesive consumption</span><span class="control"><input id="adhesive" type="number" value="4" min="0.1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">kg/m²</span></span></label><label class="field" for="materialWaste"><span>Material application allowance</span><span class="control"><input id="materialWaste" type="number" value="10" min="0" max="50" step="any" required data-role="" inputmode="decimal"><span class="suffix">%</span></span></label><label class="field" for="adhesivePack"><span>Adhesive bag</span><span class="control"><input id="adhesivePack" type="number" value="20" min="0.1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">kg</span></span></label><label class="field" for="groutPack"><span>Grout pack</span><span class="control"><input id="groutPack" type="number" value="5" min="0.1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">kg</span></span></label><label class="field" for="underlayWaste"><span>Underlayment allowance</span><span class="control"><input id="underlayWaste" type="number" value="5" min="0" max="50" step="any" required data-role="" inputmode="decimal"><span class="suffix">%</span></span></label><label class="field" for="underlayPack"><span>Underlay pack coverage</span><span class="control"><input id="underlayPack" type="number" value="10" min="0.1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">m²</span></span></label></div><p class="hint">Pattern changes the illustrative grid; you enter the cutting allowance. No cut-reuse or global material optimum is claimed.</p></section></div></details><details class="advanced"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 4 1-3h4l1 3 3 2 3 1v4l-3 2-1 3v3l-4 2-2-3-3-1H5l-2-4 3-2 1-3V7l2-3Z"/><circle cx="12" cy="11" r="3"/></svg>Custom polygon, borders &amp; orientation<span aria-hidden="true">＋</span></summary><div class="advanced-body"><section class="field-group"><h3>Custom polygon, borders &amp; orientation</h3><div class="fields"><label class="field" for="borderWidth"><span>Border width · optional</span><span class="control"><input id="borderWidth" type="number" value="0" min="0" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">mm</span></span></label><label class="field" for="orientation"><span>Tile orientation</span><select id="orientation"><option>Length along room</option><option>Width along room</option></select></label></div><p class="hint">Custom Shape accepts a measured area or a simple polygon below. Borders report area separately; a different border tile must be ordered as a separate material.</p></section><label class="polygon-label">Custom polygon · x,y pairs in the selected unit<textarea id="polygon" rows="3" placeholder="0,0; 6,0; 6,4; 0,4"></textarea></label><p class="hint">Leave empty to use measured net area. Polygon must be simple and non-intersecting.</p></div></details></div></div><div class="civil-result-column"><section class="visual-card"><div class="section-head"><h2>Floor finish & layout preview</h2><span class="illustrative">Illustrative material view</span></div><div class="artwork"><img src="/civil/assets/tile-flooring.png" alt="Realistic tile / flooring material illustration; geometry is illustrative"><div class="dimension-badges"></div></div><div class="visual-extra"></div><div class="basis-banner"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 10v7m0-11v1"/></svg><span class="visual-caption"></span></div></section><section class="results" aria-label="Calculation results" data-stale="false"><div class="section-head"><h2><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 7 9-4 9 4v10l-9 4-9-4V7Zm0 0 9 4 9-4M12 11v10"/></svg>Results Summary</h2><span class="status" role="status">Calculated</span></div><div class="kpis"></div><h3 class="calculation-details-heading">Calculation Details</h3><div class="result-lower"><div class="result-detail"></div><div class="result-cost"></div></div></section>
<div class="output"><button type="button" class="print"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8V3h12v5M6 16H3V8h18v8h-3M6 13h12v8H6z"/></svg>Print / Save PDF</button><button type="button" class="copy"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V3H3v14h5"/></svg>Copy Summary</button><p class="copy-status" role="status"></p></div></div></form>
  <details class="warning"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 10v7m0-11v1"/></svg>Important Notes / Warnings <span aria-hidden="true">⌄</span></summary><p>Area-based purchasing with explicit cuts/spares. The preview is not a certified installation or optimized cutting plan. Artwork is illustrative. This is an independent reference prototype, not a production engine or certified engineering design.</p></details>
</div>
<script is:inline src="/civil/config-tile-flooring.js"></script>
<script is:inline src="/civil/pricing.js"></script>
<script is:inline src="/civil/reference.js"></script>
