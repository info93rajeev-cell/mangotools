---
// Generated component for paint-calculator
---
<div class="civil-workspace-container" data-civil-tool="paint">
  <form id="calculator" novalidate class="civil-workspace"><div class="civil-input-column"><section class="input-card"><h2 class="sr-only">Surfaces & Paint Specification</h2><div class="mode-bar" aria-label="Calculation workflow"><button type="button" data-mode="Interior Walls" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">▰</span>Interior Walls</button><button type="button" data-mode="Exterior Walls" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">▤</span>Exterior Walls</button><button type="button" data-mode="Ceiling" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">▥</span>Ceiling</button><button type="button" data-mode="Both" aria-pressed="true"><span class="mode-symbol" aria-hidden="true">▱</span>Both</button><button type="button" data-mode="Custom" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">◇</span>Custom</button></div><div class="unit-row"><span class="mode-context"></span><label>Dimension unit <select id="unit"><option>m</option><option>ft</option></select></label></div><div class="dimensions"></div><div class="conditional-rows"></div><section class="field-group"><h3>Paint product &amp; application</h3><div class="fields"><label class="field" for="paintType"><span>Paint category</span><select id="paintType"><option>Interior emulsion</option><option>Exterior masonry</option><option>Ceiling paint</option><option>Wood / metal · custom coverage</option></select></label><label class="field" for="coats"><span>Finish coats</span><span class="control"><input id="coats" type="number" value="2" min="1" max="8" step="any" required data-role="" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="coverage"><span>Coverage · per coat</span><span class="control"><input id="coverage" type="number" value="12" min="0.1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">m²/L</span></span></label><label class="field" for="waste"><span>Application allowance</span><span class="control"><input id="waste" type="number" value="10" min="0" max="50" step="any" required data-role="" inputmode="decimal"><span class="suffix">%</span></span></label></div></section><section class="row-section" data-rows="openings"><div class="section-head"><h3>Openings / deductions</h3><span class="row-count"></span></div><div class="row-scroll"><div class="row-head"><span>Type</span><span>Width</span><span>Height</span><span>Qty</span><span></span></div><div class="rows"></div></div><button type="button" class="add-row small" data-add="openings">＋ Add opening</button></section><div class="validation" role="alert" hidden></div><div class="calculate-row"><button type="submit" class="calculate"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M8 6h8M8 11h2m3 0h2M8 15h2m3 0h2M8 19h2m3 0h2"/></svg>Calculate</button><button type="button" class="reset">Reset</button></div></section>
<div class="advanced-list"><details class="pricing"><summary><span class="price-heading" role="heading" aria-level="2">Cost Estimate <small>Optional · edit rates</small></span><strong class="pricing-total" aria-live="polite"></strong><span aria-hidden="true">＋</span></summary><div class="pricing-body"><div class="pricing-settings"><label class="price-enable"><input id="pricingEnabled" type="checkbox" checked>Include pricing</label><label class="currency-label">Currency<select id="currency"><option value="INR">INR (₹)</option><option value="USD">USD ($)</option><option value="EUR">EUR (€)</option><option value="GBP">GBP (£)</option></select></label></div><p class="pricing-note">Your entered rates only. Zero rates add no cost. Currency changes the label; amounts are not converted. No live prices or FX.</p><div class="pricing-fields"><label class="field" for="paintRate"><span>Finish / litre purchased</span><span class="control"><input id="paintRate" type="number" value="450" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="primerRate"><span>Primer / litre purchased</span><span class="control"><input id="primerRate" type="number" value="180" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="prepRate"><span>Preparation / m²</span><span class="control"><input id="prepRate" type="number" value="0" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="paintLabourRate"><span>Painting labour / m²</span><span class="control"><input id="paintLabourRate" type="number" value="0" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="otherCharges"><span>Other charges · flat</span><span class="control"><input id="otherCharges" type="number" value="0" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label></div><div class="pricing-breakdown"></div><p class="pricing-rounding">Line amounts round to 2 decimal places; the total sums those lines. Cost uses calculated quantities before display rounding.</p><button type="button" class="recalculate-pricing">Recalculate estimate</button></div></details><details class="advanced"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 4 1-3h4l1 3 3 2 3 1v4l-3 2-1 3v3l-4 2-2-3-3-1H5l-2-4 3-2 1-3V7l2-3Z"/><circle cx="12" cy="11" r="3"/></svg>Primer, surface condition &amp; purchase packs<span aria-hidden="true">＋</span></summary><div class="advanced-body"><section class="field-group"><h3>Primer, surface condition &amp; purchase packs</h3><div class="fields"><label class="field" for="surfaceCondition"><span>Surface condition</span><select id="surfaceCondition"><option>Smooth / prepared</option><option>Porous · edit measured coverage</option><option>Rough · edit measured coverage</option><option>Colour change · verify system</option></select></label><label class="field" for="primerCoats"><span>Primer coats</span><span class="control"><input id="primerCoats" type="number" value="1" min="0" max="5" step="any" required data-role="" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="primerCoverage"><span>Primer per-coat coverage</span><span class="control"><input id="primerCoverage" type="number" value="10" min="0.1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">m²/L</span></span></label><label class="field" for="pack"><span>Finish tin size</span><span class="control"><input id="pack" type="number" value="5" min="0.1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">L</span></span></label><label class="field" for="primerPack"><span>Primer tin size</span><span class="control"><input id="primerPack" type="number" value="5" min="0.1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">L</span></span></label></div><p class="hint">Coverage is user/product specific. Surface condition is recorded, never a hidden universal multiplier. Do not multiply a quoted two-coat system yield by two.</p></section></div></details><details class="advanced"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 4 1-3h4l1 3 3 2 3 1v4l-3 2-1 3v3l-4 2-2-3-3-1H5l-2-4 3-2 1-3V7l2-3Z"/><circle cx="12" cy="11" r="3"/></svg>Multiple rooms &amp; measured surfaces<span aria-hidden="true">＋</span></summary><div class="advanced-body"><section class="field-group"><h3>Multiple rooms &amp; measured surfaces</h3><div class="fields"></div><p class="hint">Additional rooms have their own lengths, widths, heights and opening deductions. They use the selected product/coat basis; do not combine different paint systems in one quantity.</p></section><section class="row-section" data-rows="rooms"><div class="section-head"><h3>Additional rooms</h3><span class="row-count"></span></div><div class="row-scroll"><div class="row-head"><span>Room</span><span>Length</span><span>Width</span><span>Height</span><span>Opening m²</span><span></span></div><div class="rows"></div></div><button type="button" class="add-row small" data-add="rooms">＋ Add room</button></section></div></details></div></div><div class="civil-result-column"><section class="visual-card"><div class="section-head"><h2>Selected paint surfaces</h2><span class="illustrative">Illustrative material view</span></div><div class="artwork"><img src="/samples/paint_room_3d.png" alt="Realistic paint material illustration; geometry is illustrative"><div class="dimension-badges"></div></div><div class="visual-extra"></div><div class="basis-banner"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 10v7m0-11v1"/></svg><span class="visual-caption"></span></div></section><section class="results" aria-label="Calculation results" data-stale="false"><div class="section-head"><h2><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 7 9-4 9 4v10l-9 4-9-4V7Zm0 0 9 4 9-4M12 11v10"/></svg>Results Summary</h2><span class="status" role="status">Calculated</span></div><div class="kpis"></div><h3 class="calculation-details-heading">Calculation Details</h3><div class="result-lower"><div class="result-detail"></div><div class="result-cost"></div></div></section>
<div class="output"><button type="button" class="print"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8V3h12v5M6 16H3V8h18v8h-3M6 13h12v8H6z"/></svg>Print / Save PDF</button><button type="button" class="copy"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V3H3v14h5"/></svg>Copy Summary</button><p class="copy-status" role="status"></p></div></div></form>
  <details class="warning"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 10v7m0-11v1"/></svg>Important Notes / Warnings <span aria-hidden="true">⌄</span></summary><p>Confirm product-specific coverage, substrate preparation and coat requirements. Primer is a separate product quantity. Artwork is illustrative. This is an independent reference prototype, not a production engine or certified engineering design.</p></details>
</div>
<script is:inline src="/civil/config-paint.js"></script>
<script is:inline src="/civil/pricing.js"></script>
<script is:inline src="/civil/reference.js"></script>
