---
// Generated component for brickwork-calculator
---
<div class="civil-workspace-container" data-civil-tool="brickwork">
  <form id="calculator" novalidate class="civil-workspace"><div class="civil-input-column"><section class="input-card"><h2 class="sr-only">Wall Dimensions & Materials</h2><div class="mode-bar" aria-label="Calculation workflow"><button type="button" data-mode="Single Wall" aria-pressed="true"><span class="mode-symbol" aria-hidden="true">▰</span>Single Wall</button><button type="button" data-mode="Multiple Walls" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">▤</span>Multiple Walls</button><button type="button" data-mode="Room" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">▥</span>Room</button></div><div class="unit-row"><span class="mode-context"></span><label>Dimension unit <select id="unit"><option>m</option><option>ft</option></select></label></div><div class="dimensions"></div><div class="conditional-rows"><section class="row-section" data-rows="walls"><div class="section-head"><h3>Wall schedule</h3><span class="row-count"></span></div><div class="row-scroll"><div class="row-head"><span>Wall</span><span>Length</span><span>Height</span><span>Thickness</span><span>Qty</span><span>Deduction m²</span><span></span></div><div class="rows"></div></div><button type="button" class="add-row small" data-add="walls">＋ Add wall</button></section></div><section class="field-group"><h3>Brick &amp; mortar</h3><div class="fields"><label class="field" for="brickPreset"><span>Brick standard</span><select id="brickPreset"><option>Modular · 190×90×90</option><option>UK · 215×102.5×65</option><option>Custom</option></select></label><label class="field" for="joint"><span>Mortar joint</span><span class="control"><input id="joint" type="number" value="10" min="0" max="30" step="any" required data-role="" inputmode="decimal"><span class="suffix">mm</span></span></label><label class="field" for="sandParts"><span>Cement : sand</span><span class="control"><input id="sandParts" type="number" value="6" min="1" max="12" step="any" required data-role="" inputmode="decimal"><span class="suffix">1 :</span></span></label><label class="field" for="brickWaste"><span>Brick wastage</span><span class="control"><input id="brickWaste" type="number" value="5" min="0" max="50" step="any" required data-role="" inputmode="decimal"><span class="suffix">%</span></span></label></div></section><section class="row-section" data-rows="openings"><div class="section-head"><h3>Openings / deductions</h3><span class="row-count"></span></div><div class="row-scroll"><div class="row-head"><span>Type</span><span>Width</span><span>Height</span><span>Qty</span><span></span></div><div class="rows"></div></div><button type="button" class="add-row small" data-add="openings">＋ Add opening</button></section><div class="validation" role="alert" hidden></div><div class="calculate-row"><button type="submit" class="calculate"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M8 6h8M8 11h2m3 0h2M8 15h2m3 0h2M8 19h2m3 0h2"/></svg>Calculate</button><button type="button" class="reset">Reset</button></div></section>
<div class="advanced-list"><details class="pricing"><summary><span class="price-heading" role="heading" aria-level="2">Cost Estimate <small>Optional · edit rates</small></span><strong class="pricing-total" aria-live="polite"></strong><span aria-hidden="true">＋</span></summary><div class="pricing-body"><div class="pricing-settings"><label class="price-enable"><input id="pricingEnabled" type="checkbox" checked>Include pricing</label><label class="currency-label">Currency<select id="currency"><option value="INR">INR (₹)</option><option value="USD">USD ($)</option><option value="EUR">EUR (€)</option><option value="GBP">GBP (£)</option></select></label></div><p class="pricing-note">Your entered rates only. Zero rates add no cost. Currency changes the label; amounts are not converted. No live prices or FX.</p><div class="pricing-fields"><label class="field" for="brickRate"><span>Brick / piece</span><span class="control"><input id="brickRate" type="number" value="8" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="cementRate"><span>Cement / bag</span><span class="control"><input id="cementRate" type="number" value="420" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="sandRate"><span>Sand / m³</span><span class="control"><input id="sandRate" type="number" value="1600" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="labourRate"><span>Labour / net wall m²</span><span class="control"><input id="labourRate" type="number" value="0" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="otherCharges"><span>Other charges · flat</span><span class="control"><input id="otherCharges" type="number" value="0" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label></div><div class="pricing-breakdown"></div><p class="pricing-rounding">Line amounts round to 2 decimal places; the total sums those lines. Cost uses calculated quantities before display rounding.</p><button type="button" class="recalculate-pricing">Recalculate estimate</button></div></details><details class="advanced"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 4 1-3h4l1 3 3 2 3 1v4l-3 2-1 3v3l-4 2-2-3-3-1H5l-2-4 3-2 1-3V7l2-3Z"/><circle cx="12" cy="11" r="3"/></svg>Brick dimensions, bond &amp; material assumptions<span aria-hidden="true">＋</span></summary><div class="advanced-body"><section class="field-group"><h3>Brick dimensions, bond &amp; material assumptions</h3><div class="fields"><label class="field" for="brickL"><span>Actual brick length</span><span class="control"><input id="brickL" type="number" value="190" min="1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">mm</span></span></label><label class="field" for="brickW"><span>Actual brick width</span><span class="control"><input id="brickW" type="number" value="90" min="1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">mm</span></span></label><label class="field" for="brickH"><span>Actual brick height</span><span class="control"><input id="brickH" type="number" value="90" min="1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">mm</span></span></label><label class="field" for="bond"><span>Bond / orientation note</span><select id="bond"><option>Stretcher / module estimate</option><option>English bond · quantity basis only</option><option>Flemish bond · quantity basis only</option><option>Project specification</option></select></label><label class="field" for="mortarWaste"><span>Mortar allowance</span><span class="control"><input id="mortarWaste" type="number" value="5" min="0" max="50" step="any" required data-role="" inputmode="decimal"><span class="suffix">%</span></span></label><label class="field" for="dryFactor"><span>Dry / wet factor</span><span class="control"><input id="dryFactor" type="number" value="1.33" min="1" max="2" step="any" required data-role="" inputmode="decimal"><span class="suffix">×</span></span></label><label class="field" for="density"><span>Loose cement density</span><span class="control"><input id="density" type="number" value="1440" min="100" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">kg/m³</span></span></label><label class="field" for="bag"><span>Cement bag</span><span class="control"><input id="bag" type="number" value="50" min="1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">kg</span></span></label></div><p class="hint">Bond is recorded as a specification note. The volume module is not a validated coursing/cut planner. Room dimensions use the wall centreline to avoid corner double-counting.</p></section></div></details><details class="advanced"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 4 1-3h4l1 3 3 2 3 1v4l-3 2-1 3v3l-4 2-2-3-3-1H5l-2-4 3-2 1-3V7l2-3Z"/><circle cx="12" cy="11" r="3"/></svg>Optional plaster allowance<span aria-hidden="true">＋</span></summary><div class="advanced-body"><section class="field-group"><h3>Optional plaster allowance</h3><div class="fields"><label class="field" for="plasterFaces"><span>Plaster faces · optional</span><span class="control"><input id="plasterFaces" type="number" value="0" min="0" max="2" step="any" required data-role="" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="plasterThickness"><span>Plaster thickness</span><span class="control"><input id="plasterThickness" type="number" value="12" min="1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">mm</span></span></label></div><p class="hint">Plaster area/volume is a separate handoff, not silently mixed into masonry mortar.</p></section></div></details></div></div><div class="civil-result-column"><section class="visual-card"><div class="section-head"><h2>Wall geometry & openings</h2><span class="illustrative">Illustrative material view</span></div><div class="artwork"><img src="/civil/assets/brickwork.png" alt="Realistic brickwork material illustration; geometry is illustrative"><div class="dimension-badges"></div></div><div class="visual-extra"></div><div class="basis-banner"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 10v7m0-11v1"/></svg><span class="visual-caption"></span></div></section><section class="results" aria-label="Calculation results" data-stale="false"><div class="section-head"><h2><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 7 9-4 9 4v10l-9 4-9-4V7Zm0 0 9 4 9-4M12 11v10"/></svg>Results Summary</h2><span class="status" role="status">Calculated</span></div><div class="kpis"></div><h3 class="calculation-details-heading">Calculation Details</h3><div class="result-lower"><div class="result-detail"></div><div class="result-cost"></div></div></section>
<div class="output"><button type="button" class="print"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8V3h12v5M6 16H3V8h18v8h-3M6 13h12v8H6z"/></svg>Print / Save PDF</button><button type="button" class="copy"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V3H3v14h5"/></svg>Copy Summary</button><p class="copy-status" role="status"></p></div></div></form>
  <details class="warning"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 10v7m0-11v1"/></svg>Important Notes / Warnings <span aria-hidden="true">⌄</span></summary><p>Use actual solid-brick dimensions and specified joints. Bond, cuts and plaster remain explicit assumptions. Artwork is illustrative. This is an independent reference prototype, not a production engine or certified engineering design.</p></details>
</div>
<script is:inline src="/civil/config-brickwork.js"></script>
<script is:inline src="/civil/pricing.js"></script>
<script is:inline src="/civil/reference.js"></script>
