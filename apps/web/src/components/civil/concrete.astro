---
// Generated component for concrete-quantity-calculator
---
<div class="civil-workspace-container" data-civil-tool="concrete">
  <form id="calculator" novalidate class="civil-workspace"><div class="civil-input-column"><section class="input-card"><h2 class="sr-only">Concrete Elements & Materials</h2><div class="mode-bar" aria-label="Calculation workflow"><button type="button" data-mode="Slab" aria-pressed="true"><span class="mode-symbol" aria-hidden="true">▰</span>Slab</button><button type="button" data-mode="Beam" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">▤</span>Beam</button><button type="button" data-mode="Column" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">▥</span>Column</button><button type="button" data-mode="Footing" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">▱</span>Footing</button><button type="button" data-mode="Custom" aria-pressed="false"><span class="mode-symbol" aria-hidden="true">◇</span>Custom</button></div><div class="unit-row"><span class="mode-context"></span><label>Dimension unit <select id="unit"><option>m</option><option>ft</option></select></label></div><div class="dimensions"></div><div class="conditional-rows"></div><section class="field-group"><h3>Concrete &amp; procurement</h3><div class="fields"><label class="field" for="mixMode"><span>Material workflow</span><select id="mixMode"><option>Site mix · nominal</option><option>Ready-mix · order</option></select></label><label class="field" for="mix"><span>Nominal volume ratio</span><select id="mix"><option>1 : 1.5 : 3</option><option>1 : 2 : 4</option><option>Custom ratio</option></select></label><label class="field" for="waste"><span>Site wastage</span><span class="control"><input id="waste" type="number" value="5" min="0" max="50" step="any" required data-role="" inputmode="decimal"><span class="suffix">%</span></span></label><label class="field" for="bag"><span>Cement bag</span><span class="control"><input id="bag" type="number" value="50" min="1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">kg</span></span></label><label class="field" for="grade"><span>Specified grade · record only</span><select id="grade"><option>Project-specified</option><option>M15</option><option>M20</option><option>M25</option><option>M30</option></select></label><label class="field" for="increment"><span>Order increment</span><span class="control"><input id="increment" type="number" value="0.1" min="0.001" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">m³</span></span></label></div></section><div class="validation" role="alert" hidden></div><div class="calculate-row"><button type="submit" class="calculate"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M8 6h8M8 11h2m3 0h2M8 15h2m3 0h2M8 19h2m3 0h2"/></svg>Calculate</button><button type="button" class="reset">Reset</button></div></section>
<div class="advanced-list"><details class="pricing"><summary><span class="price-heading" role="heading" aria-level="2">Cost Estimate <small>Optional · edit rates</small></span><strong class="pricing-total" aria-live="polite"></strong><span aria-hidden="true">＋</span></summary><div class="pricing-body"><div class="pricing-settings"><label class="price-enable"><input id="pricingEnabled" type="checkbox" checked>Include pricing</label><label class="currency-label">Currency<select id="currency"><option value="INR">INR (₹)</option><option value="USD">USD ($)</option><option value="EUR">EUR (€)</option><option value="GBP">GBP (£)</option></select></label></div><p class="pricing-note">Your entered rates only. Zero rates add no cost. Currency changes the label; amounts are not converted. No live prices or FX.</p><div class="pricing-fields"><label class="field" for="cementRate"><span>Cement / bag</span><span class="control"><input id="cementRate" type="number" value="420" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="sandRate"><span>Sand / m³</span><span class="control"><input id="sandRate" type="number" value="1600" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="aggregateRate"><span>Aggregate / m³</span><span class="control"><input id="aggregateRate" type="number" value="1400" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="rate"><span>Ready-mix / ordered m³</span><span class="control"><input id="rate" type="number" value="6500" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="concreteLabourRate"><span>Placing labour / required m³</span><span class="control"><input id="concreteLabourRate" type="number" value="0" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="otherCharges"><span>Other charges · flat</span><span class="control"><input id="otherCharges" type="number" value="0" min="0" max="1000000" step="any" required data-role="" data-price="true" inputmode="decimal"><span class="suffix"></span></span></label></div><div class="pricing-breakdown"></div><p class="pricing-rounding">Line amounts round to 2 decimal places; the total sums those lines. Cost uses calculated quantities before display rounding.</p><button type="button" class="recalculate-pricing">Recalculate estimate</button></div></details><details class="advanced"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 4 1-3h4l1 3 3 2 3 1v4l-3 2-1 3v3l-4 2-2-3-3-1H5l-2-4 3-2 1-3V7l2-3Z"/><circle cx="12" cy="11" r="3"/></svg>Mix assumptions &amp; displacement<span aria-hidden="true">＋</span></summary><div class="advanced-body"><section class="field-group"><h3>Mix assumptions &amp; displacement</h3><div class="fields"><label class="field" for="dryFactor"><span>Dry / wet factor</span><span class="control"><input id="dryFactor" type="number" value="1.54" min="1" max="2" step="any" required data-role="" inputmode="decimal"><span class="suffix">×</span></span></label><label class="field" for="sandParts"><span>Sand parts per cement</span><span class="control"><input id="sandParts" type="number" value="1.5" min="0.1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="aggParts"><span>Aggregate parts</span><span class="control"><input id="aggParts" type="number" value="3" min="0.1" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix"></span></span></label><label class="field" for="density"><span>Loose cement density</span><span class="control"><input id="density" type="number" value="1440" min="100" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">kg/m³</span></span></label><label class="field" for="displacement"><span>Verified displacement</span><span class="control"><input id="displacement" type="number" value="0" min="0" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">m³</span></span></label></div><p class="hint">Nominal ratios do not certify a concrete grade. Design-mix quantities must come from the approved mix design. Displacement defaults to zero.</p></section></div></details><details class="advanced"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 4 1-3h4l1 3 3 2 3 1v4l-3 2-1 3v3l-4 2-2-3-3-1H5l-2-4 3-2 1-3V7l2-3Z"/><circle cx="12" cy="11" r="3"/></svg>Multiple elements &amp; bagged-product yield<span aria-hidden="true">＋</span></summary><div class="advanced-body"><section class="field-group"><h3>Multiple elements &amp; bagged-product yield</h3><div class="fields"><label class="field" for="bagYield"><span>Bagged product yield</span><span class="control"><input id="bagYield" type="number" value="0.025" min="0.001" max="1000000" step="any" required data-role="" inputmode="decimal"><span class="suffix">m³/bag</span></span></label></div><p class="hint">Additional rectangular elements can be added below. Bagged ready-mix yield is an entered product value, independent of cement bags in site mix.</p></section><section class="row-section" data-rows="elements"><div class="section-head"><h3>Additional rectangular elements</h3><span class="row-count"></span></div><div class="row-scroll"><div class="row-head"><span>Element</span><span>Length</span><span>Width</span><span>Depth</span><span>Qty</span><span></span></div><div class="rows"></div></div><button type="button" class="add-row small" data-add="elements">＋ Add element</button></section></div></details></div></div><div class="civil-result-column"><section class="visual-card"><div class="section-head"><h2>Selected concrete element</h2><span class="illustrative">Illustrative material view</span></div><div class="artwork"><img src="/civil/assets/concrete.png" alt="Realistic concrete quantity material illustration; geometry is illustrative"><div class="dimension-badges"></div></div><div class="visual-extra"></div><div class="basis-banner"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 10v7m0-11v1"/></svg><span class="visual-caption"></span></div></section><section class="results" aria-label="Calculation results" data-stale="false"><div class="section-head"><h2><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 7 9-4 9 4v10l-9 4-9-4V7Zm0 0 9 4 9-4M12 11v10"/></svg>Results Summary</h2><span class="status" role="status">Calculated</span></div><div class="kpis"></div><h3 class="calculation-details-heading">Calculation Details</h3><div class="result-lower"><div class="result-detail"></div><div class="result-cost"></div></div></section>
<div class="output"><button type="button" class="print"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8V3h12v5M6 16H3V8h18v8h-3M6 13h12v8H6z"/></svg>Print / Save PDF</button><button type="button" class="copy"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V3H3v14h5"/></svg>Copy Summary</button><p class="copy-status" role="status"></p></div></div></form>
  <details class="warning"><summary><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 10v7m0-11v1"/></svg>Important Notes / Warnings <span aria-hidden="true">⌄</span></summary><p>Quantity estimate only. A nominal 1:1.5:3 ratio is not an engineered M20/design-mix or strength guarantee. Artwork is illustrative. This is an independent reference prototype, not a production engine or certified engineering design.</p></details>
</div>
<script is:inline src="/civil/config-concrete.js"></script>
<script is:inline src="/civil/pricing.js"></script>
<script is:inline src="/civil/reference.js"></script>
