---
import type { RegistryTool } from '@mangotools/schemas';
import { presetCurrency } from '@mangotools/ui/toolkit/presentation.ts';
import { ToolIsland } from '@mangotools/ui/toolkit/ToolIsland.tsx';
import { t } from '@mangotools/ui/strings/en.ts';
import Breadcrumbs from '@mangotools/ui/layout/Breadcrumbs.astro';
import PageContainer from '@mangotools/ui/layout/PageContainer.astro';
import Disclaimer from '@mangotools/ui/toolkit/Disclaimer.astro';
import ToolContent from '@mangotools/ui/toolkit/ToolContent.astro';
import ToolHeader from '@mangotools/ui/toolkit/ToolHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryById, presetFor, toolLinks, toolTitle } from '../lib/site.ts';
import { breadcrumbList, faqPage, webApplication } from '../lib/structured-data.ts';

interface Props {
  tool: RegistryTool;
}
const { tool } = Astro.props;
const preset = presetFor(tool);
const category = categoryById.get(tool.category);
const crumbs = [
  { name: 'Home', url: '/' },
  ...(category?.visible ? [{ name: category.name, url: category.url }] : []),
  { name: tool.name, url: tool.url },
];
const jsonLd = [webApplication(tool), breadcrumbList(crumbs), ...(tool.content.faq.length > 0 ? [faqPage(tool.content.faq)] : [])];
if (tool.archetype !== 'A' && tool.archetype !== 'B' && tool.archetype !== 'D') {
  throw new Error(`${tool.id}: archetype ${tool.archetype} is not available in Phase 1.`);
}
---

<BaseLayout title={toolTitle(tool)} description={tool.seo.description} path={tool.url} template="tool" jsonLd={jsonLd}>
  <PageContainer width="tool">
    <div class="page">
      <div class="top">
        <Breadcrumbs items={crumbs} />
        <ToolHeader name={tool.seo.h1 ?? tool.name} summary={tool.summary} processing={tool.processing} />
      </div>
      <ToolIsland
        client:load
        toolId={tool.id}
        archetype={tool.archetype}
        preset={preset}
        sampleId={tool.sample}
        print={tool.capabilities.print === true}
      />
      <section
        class="supporting"
        aria-labelledby="tool-information-title"
        data-secondary-information
      >
        <h2 id="tool-information-title" class="visually-hidden">{t('secondary.title')}</h2>
        <Disclaimer kind={tool.disclaimer} />
        <ToolContent content={tool.content} related={toolLinks(tool.related)} currency={presetCurrency(preset)} />
      </section>
    </div>
  </PageContainer>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-1);
  }
  .top {
    display: grid;
    gap: var(--space-1);
  }
  .supporting {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-2);
    min-width: 0;
    padding-bottom: var(--space-4);
  }
</style>
