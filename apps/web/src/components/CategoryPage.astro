---
import type { RegistryCategory } from '@mangotools/schemas';
import { CardGrid, ToolCard } from '@mangotools/ui/discovery/cards.tsx';
import Breadcrumbs from '@mangotools/ui/layout/Breadcrumbs.astro';
import PageContainer from '@mangotools/ui/layout/PageContainer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { COPY, fill } from '../lib/copy.ts';
import { toolById, toolLinks } from '../lib/site.ts';
import { breadcrumbList, itemList } from '../lib/structured-data.ts';

interface Props {
  category: RegistryCategory;
}
const { category } = Astro.props;
const copy = COPY.category;
const tools = toolLinks(category.toolIds);
const registryTools = category.toolIds.flatMap((id) => toolById.get(id) ?? []);
const crumbs = [
  { name: 'Home', url: '/' },
  { name: category.name, url: category.url },
];
const count = tools.length === 1 ? copy.one : fill(copy.count, { count: tools.length });
---

<BaseLayout
  title={category.seo.title}
  description={category.seo.description}
  path={category.url}
  template="category"
  jsonLd={[breadcrumbList(crumbs), itemList(category, registryTools)]}
>
  <PageContainer>
    <div class="page">
      <Breadcrumbs items={crumbs} />
      <header class="head">
        <div class="title-row">
          <h1>{category.name}</h1>
          <span class="count">{count}</span>
        </div>
        <p>{category.summary}</p>
      </header>
      {
        tools.length > 1 ? (
          <nav class="start" aria-label={copy.startHere}>
            <span class="start-label">{copy.startHere}:</span>
            <ul>
              {tools.slice(0, 3).map((tool) => (
                <li>
                  <a href={tool.url}>{tool.name}</a>
                </li>
              ))}
            </ul>
          </nav>
        ) : null
      }
      <section class="block tools" aria-labelledby="all-tools">
        <h2 id="all-tools">{fill(copy.allInCategory, { name: category.name })}</h2>
        <CardGrid>
          {
            tools.map((tool) => (
              <li>
                <ToolCard tool={tool} />
              </li>
            ))
          }
        </CardGrid>
      </section>
      <div class="support">
        {
          category.about && category.about.length > 0 ? (
            <details class="support-detail" data-category-support="about">
              <summary class="support-summary">
                <h2>{copy.about}</h2>
              </summary>
              <div class="support-content prose">
                {category.about.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </details>
          ) : null
        }
        {
          category.faq && category.faq.length > 0 ? (
            <details class="support-detail" data-category-support="faq">
              <summary class="support-summary">
                <h2>{copy.faq}</h2>
              </summary>
              <div class="support-content faq">
                {category.faq.map((item) => (
                  <details class="faq-item">
                    <summary class="faq-summary">
                      <h3>{item.q}</h3>
                    </summary>
                    <p>{item.a}</p>
                  </details>
                ))}
              </div>
            </details>
          ) : null
        }
      </div>
    </div>
  </PageContainer>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-8);
  }
  .head {
    display: grid;
    gap: var(--space-2);
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }
  .count {
    color: var(--color-text-subtle);
    font-size: var(--text-ui);
  }
  .head p {
    color: var(--color-text-muted);
    max-width: 65ch;
  }
  .start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-ui);
  }
  .start-label {
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
  }
  .start ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .start a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-height-sm);
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }
  .block {
    display: grid;
    gap: var(--space-4);
  }
  .support {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: var(--space-2);
  }
  .support-detail {
    width: fit-content;
    max-width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
  }
  .support-detail[open] {
    width: 100%;
    border-radius: var(--radius-lg);
  }
  .support-summary,
  .faq-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    cursor: pointer;
    list-style: none;
  }
  .support-summary {
    min-height: var(--control-height-sm);
    padding: var(--space-1) var(--space-3);
  }
  .support-summary::-webkit-details-marker,
  .faq-summary::-webkit-details-marker {
    display: none;
  }
  .support-summary::after,
  .faq-summary::after {
    content: '+';
    color: var(--color-text-subtle);
  }
  details[open] > .support-summary::after,
  details[open] > .faq-summary::after {
    content: '−';
  }
  .support-summary h2 {
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
  }
  .support-content {
    padding: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .prose {
    max-width: 72ch;
  }
  .prose p {
    color: var(--color-text-muted);
  }
  .prose p + p {
    margin-top: var(--space-3);
  }
  .faq {
    display: grid;
    max-width: 880px;
  }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
  }
  .faq-item:last-child {
    border-bottom: 0;
  }
  .faq-summary {
    padding: var(--space-4) 0;
  }
  .faq-summary h3 {
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .faq-item p {
    padding-bottom: var(--space-4);
    color: var(--color-text-muted);
    max-width: 72ch;
  }

  @media (min-width: 768px) {
    .page {
      gap: var(--space-3);
    }
    .head {
      gap: var(--space-1);
    }
    .head p {
      line-height: var(--leading-ui);
    }
    .block {
      gap: var(--space-2);
    }
    .block > h2 {
      font-size: 1.25rem;
      line-height: 1.75rem;
    }
    .tools :global(ul) {
      gap: var(--space-3);
    }
    .tools :global([data-tool-card]) {
      gap: var(--space-1);
      padding: var(--space-3);
    }
    .tools :global([data-tool-card] h3) {
      font-size: var(--text-body);
      line-height: 1.25rem;
    }
    .tools :global([data-tool-card] > p) {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
    .tools :global([data-tool-card] > div) {
      margin-top: 0;
    }
  }
</style>
