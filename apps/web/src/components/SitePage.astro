---
import Breadcrumbs from '@mangotools/ui/layout/Breadcrumbs.astro';
import PageContainer from '@mangotools/ui/layout/PageContainer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { COPY, fill } from '../lib/copy.ts';
import type { SitePage } from '../lib/pages.ts';
import { breadcrumbList } from '../lib/structured-data.ts';

interface Props {
  page: SitePage;
}
const { page } = Astro.props;
const { frontMatter, Content } = page;
const crumbs = [
  { name: 'Home', url: '/' },
  { name: page.label, url: page.url },
];
---

<BaseLayout
  title={frontMatter.title}
  description={frontMatter.description}
  path={page.url}
  template="page"
  noindex={page.draft}
  jsonLd={[breadcrumbList(crumbs)]}
>
  <PageContainer width="tool">
    <article class="page" data-site-page={page.slug} data-status={frontMatter.status}>
      <Breadcrumbs items={crumbs} />
      {page.draft ? <p class="draft" role="note">{COPY.pages.draft}</p> : null}
      <header class="head">
        <h1>{frontMatter.heading}</h1>
        <p class="updated">{fill(COPY.pages.lastUpdated, { date: frontMatter.lastUpdated })}</p>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </PageContainer>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
    max-width: 880px;
  }
  .head {
    display: grid;
    gap: var(--space-2);
  }
  .updated {
    color: var(--color-text-muted);
    font-size: var(--text-ui);
  }
  .draft {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    font-size: var(--text-ui);
  }
  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: 72ch;
  }
  .prose :global(h2) {
    margin-top: var(--space-4);
  }
  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-6);
  }
  .prose :global(li::marker) {
    color: var(--color-text-subtle);
  }
  .prose :global(table) {
    border-collapse: collapse;
    font-size: var(--text-ui);
  }
  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(code) {
    padding: 1px 5px;
    border-radius: var(--radius-sm);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    font-size: 0.875em;
  }
</style>
