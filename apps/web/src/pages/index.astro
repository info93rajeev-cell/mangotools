---
import { CardGrid, CategoryCard } from '@mangotools/ui/discovery/cards.tsx';
import { SearchBox } from '@mangotools/ui/discovery/SearchBox.tsx';
import PageContainer from '@mangotools/ui/layout/PageContainer.astro';
import logoUrl from '../../../../assets/brand/logo.svg?url';
import BaseLayout from '../layouts/BaseLayout.astro';
import { organization, webSite } from '../lib/structured-data.ts';
import { COPY } from '../lib/copy.ts';
import { HOME, visibleCategories } from '../lib/site.ts';

const copy = COPY.home;
---

<BaseLayout
  title={HOME.title}
  description={HOME.description}
  path="/"
  template="home"
  showHeaderSearch={false}
  jsonLd={[organization(logoUrl), webSite()]}
>
  <PageContainer>
    <div class="sections">
      <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title">{copy.heading}</h1>
        <p class="lede">{copy.lede}</p>
        <div class="hero-search">
          <SearchBox client:load idPrefix="home-search" />
        </div>
      </section>

      <section class="block" aria-labelledby="categories-title">
        <h2 id="categories-title">{copy.categories}</h2>
        <CardGrid>
          {
            visibleCategories.map((c) => (
              <li>
                <CategoryCard
                  name={c.name}
                  summary={c.summary}
                  url={c.url}
                  icon={c.icon}
                  count={c.toolIds.length}
                  compact
                />
              </li>
            ))
          }
        </CardGrid>
      </section>

      <p class="trust" data-trust-line>{copy.trust}</p>
    </div>
  </PageContainer>
</BaseLayout>

<style>
  .sections {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-2);
  }
  .hero {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding-block: var(--space-6) 0;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(2rem, 1.6rem + 2vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 26ch;
  }
  .lede {
    max-width: 60ch;
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }
  .hero-search {
    width: min(100%, 680px);
    text-align: left;
  }
  .block {
    display: grid;
    gap: var(--space-3);
  }
  .trust {
    color: var(--color-text-muted);
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
    text-align: center;
  }
  @media (max-width: 640px) {
    .sections {
      gap: var(--space-8);
      padding-bottom: var(--space-6);
    }
    .hero {
      padding-block: var(--space-8) var(--space-2);
    }
    .block {
      gap: var(--space-5);
    }
  }
</style>
