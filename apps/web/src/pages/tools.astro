---
import { CategoryChips } from '@mangotools/ui/discovery/CategoryChips.tsx';
import { CardGrid, ToolCard } from '@mangotools/ui/discovery/cards.tsx';
import { SearchBox } from '@mangotools/ui/discovery/SearchBox.tsx';
import Breadcrumbs from '@mangotools/ui/layout/Breadcrumbs.astro';
import PageContainer from '@mangotools/ui/layout/PageContainer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { COPY } from '../lib/copy.ts';
import { ALL_TOOLS, toolLinks, visibleCategories } from '../lib/site.ts';
import { breadcrumbList } from '../lib/structured-data.ts';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: COPY.tools.heading, url: '/tools' },
];
const groups = visibleCategories.map((c) => ({ category: c, tools: toolLinks(c.toolIds) }));
---

<BaseLayout
  title={ALL_TOOLS.title}
  description={ALL_TOOLS.description}
  path="/tools"
  template="tools"
  jsonLd={[breadcrumbList(crumbs)]}
>
  <PageContainer>
    <div class="page">
      <Breadcrumbs items={crumbs} />
      <header class="head">
        <h1>{COPY.tools.heading}</h1>
        <p>{COPY.tools.lede}</p>
      </header>
      <div class="search">
        <SearchBox client:load idPrefix="tools-search" />
      </div>
      <CategoryChips client:idle categories={visibleCategories.map((c) => ({ id: c.id, name: c.name }))} />
      {
        groups.map(({ category, tools }) => (
          <section class="group" data-category-group data-category={category.id} aria-labelledby={`group-${category.id}`}>
            <h2 id={`group-${category.id}`}>
              <a href={category.url}>{category.name}</a>
            </h2>
            <CardGrid>
              {tools.map((tool) => (
                <li>
                  <ToolCard tool={tool} />
                </li>
              ))}
            </CardGrid>
          </section>
        ))
      }
    </div>
  </PageContainer>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
  }
  .head {
    display: grid;
    gap: var(--space-2);
  }
  .head p {
    color: var(--color-text-muted);
  }
  .search {
    max-width: 640px;
  }
  .group {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-4);
  }
  .group h2 a {
    color: inherit;
    text-decoration: none;
  }
  .group h2 a:hover {
    text-decoration: underline;
  }
</style>
