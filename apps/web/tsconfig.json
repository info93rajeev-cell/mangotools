{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": { "@generated/*": ["../../generated/*"] }
  },
  "include": [".astro/types.d.ts", "src/**/*", "../../packages/ui/src/env.d.ts"],
  "exclude": ["dist", "dist-*"]
}
