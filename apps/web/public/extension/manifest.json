{
  "manifest_version": 3,
  "name": "BeyondTheAI - Image Format Converter",
  "short_name": "BeyondTheAI Converter",
  "version": "1.0.0",
  "description": "Convert images to JPG, PNG, WebP, and PDF 100% in your browser. Fast, private, and offline-capable.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BeyondTheAI - Image Format Converter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
